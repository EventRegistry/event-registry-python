# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Sphinx documentation
docs/_build/

# PyBuilder
target/
/requests_log.txt

# Compiled python modules.
*.pyc

# Setuptools distribution folder.
/dist/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info
/.vs/EventRegistryAPI/v14/*.suo
/*.user
/eventregistry/requests_log.txt

# Editor settings
/.vscode/

# Local settings with the API keys (root, eventregistry/, eventregistry/tests/, eventregistry/examples/, ...)
settings*.json

# Log of the requests made by the SDK
requests_log.txt

# Caches of the tools
.pytest_cache/
.mypy_cache/

# Local release script
uploadNewVersion.bat

# The online tests use the live data (and a fixed backend instance), so they are kept only locally
/eventregistry/tests/DataValidator.py
/eventregistry/tests/TestER*.py
/eventregistry/tests/TestAnalytics.py
